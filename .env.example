# ---------------------------------------------------------------------------
# Celo (mainnet)
# ---------------------------------------------------------------------------
CELO_RPC_URL=https://forno.celo.org
CELO_CHAIN_ID=42220

# Verified on-chain 2026-09-07. Do not edit without re-verifying with `cast code`.
CNGN_ADDRESS=0xF6829D7393dAe24509eb1E52eE8e572e2E271a4f   # 6 decimals
USDT_ADDRESS=0x48065fbbe25f71c9282ddf5e1cd6d6a887483d5e   # 6 decimals - the funding asset
UNISWAP_V3_ROUTER=0x5615CDAb10dc425a742d643d949a7F474C01abc4
UNISWAP_V3_QUOTER=0x82825d0554fA07f7FC52Ab63c961F330fdEFa8E8
UNISWAP_V3_FACTORY=0xAfE208a311B21f13EF87E33A90049fC17A7acDEc
CNGN_USDT_POOL=0x6519d56eb0a69fc0338657784c783b169b8f7d32
POOL_FEE_TIER=100

# Celo Sepolia testnet (run the contract here before mainnet)
# CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
# CELO_CHAIN_ID=11142220
# CNGN_ADDRESS=0xa188439ccCEe9A6aa0E842f9c17C1b00C7B4dd4D

REMESSO_EXECUTOR_ADDRESS=
# Backend hot key. Can ONLY call executeRun(). Cannot alter any schedule policy.
EXECUTOR_PRIVATE_KEY=
CELOSCAN_API_KEY=

# ---------------------------------------------------------------------------
# cNGN API  (docs.cngn.co)
#
# All four values come from Settings -> API Key in the merchant dashboard, and
# every environment has its own set. See README "Getting cNGN credentials".
# ---------------------------------------------------------------------------
CNGN_API_BASE=https://api.cngn.co/v1/api

# cngn_test_... in sandbox, cngn_live_... in production. The prefix picks the
# environment; there is no separate base URL. Live keys are only issued after
# KYB onboarding is approved.
CNGN_API_KEY=

# AES-256-CBC request encryption. SHA-256'd to derive the 32-byte key. Shown
# next to the API key in the dashboard.
CNGN_ENCRYPTION_KEY=

# OpenSSH Ed25519 PRIVATE key. Generate with:
#     ssh-keygen -t ed25519 -C "api@remesso" -f cngn_api_key
# Upload cngn_api_key.pub to the dashboard and put the private half here.
#
# Do NOT set a passphrase. The docs offer one, but this runs unattended and has
# nothing to prompt with; a passphrase encrypts the key body and the private
# key cannot be loaded. Already set one? Strip it without changing the public
# key, so the dashboard needs no update:
#     ssh-keygen -p -N "" -f cngn_api_key
# Every response's `data` field is sealed to the public key, so without this
# nothing the API returns is readable — and requests fail outright with
# "No Test SSH Key found". Newlines may be escaped as \n.
CNGN_SSH_PRIVATE_KEY=

# Shared secret configured in the cNGN merchant dashboard; signs inbound
# webhooks as `X-cNGN-Signature: sha256=<hex>` over the raw body.
CNGN_WEBHOOK_SECRET=

# cNGN rejects requests from non-whitelisted source IPs with 403 regardless of
# credentials, and Supabase Edge Functions do not have a stable egress IP.
# Set this to a fixed-IP forward proxy and whitelist that IP instead.
# See README "cNGN egress: the IP whitelist problem".
CNGN_EGRESS_PROXY_URL=

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Guard rails enforced in the backend, above the on-chain envelope
MAX_SLIPPAGE_BPS=100
MAX_RUN_AMOUNT_USDT=1000
