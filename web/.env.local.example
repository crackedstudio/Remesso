# ---------------------------------------------------------------------------
# Public — these end up in the browser bundle. Nothing secret may live here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo.org
NEXT_PUBLIC_CHAIN_ID=42220
NEXT_PUBLIC_REMESSO_EXECUTOR_ADDRESS=
NEXT_PUBLIC_CNGN_ADDRESS=0xF6829D7393dAe24509eb1E52eE8e572e2E271a4f
NEXT_PUBLIC_USDT_ADDRESS=0x48065fbbe25f71c9282ddf5e1cd6d6a887483d5e

# The cNGN redemption address bank payouts are delivered to.
#
# This is the unresolved item in the root README. `redeemAsset` returns an
# address per redemption, and the contract fixes `destination` at
# authorisation — so bank payouts only work if this address is stable for the
# account. Confirm that with cNGN, set it here, and execute-due-runs re-checks
# on every run that the address cNGN hands back still matches.
# Leave blank and the UI hides bank payouts entirely.
NEXT_PUBLIC_CNGN_REDEMPTION_ADDRESS=

# ---------------------------------------------------------------------------
# Server-only. Deliberately NOT prefixed NEXT_PUBLIC_.
#
# The route handlers under app/api/cngn forward to the cngn-proxy Edge
# Function, which is the single IP-whitelisted egress holding the real cNGN
# credentials. The API key, AES key and Ed25519 key never come near this app.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
